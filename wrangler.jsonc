{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Keep this name: it is the existing Worker behind https://ibma.almarashly84.workers.dev
  "name": "ibma",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // Builds the React site into ./dist before every deploy.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/", "/index.html", "/en", "/en/", "/fr", "/fr/",
      "/privacy", "/privacy/", "/en/privacy", "/en/privacy/", "/fr/privacy", "/fr/privacy/",
      "/api/*", "/media/*", "/unsubscribe", "/robots.txt", "/sitemap.xml"
    ]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "ibma-db", "database_id": "a097d736-b549-4368-986b-e94f390adfa4" }
  ],
  // Rate limits (in memory, no database cost). period must be 10 or 60 seconds.
  "ratelimits": [
    { "name": "RL_VISITOR", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_GLOBAL", "namespace_id": "4102", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_STATS", "namespace_id": "4103", "simple": { "limit": 30, "period": 60 } }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "ibma-media" }
  ],
  // Daily clean-up: removes appointment requests older than 24 months and expired security records.
  "triggers": { "crons": ["17 7 * * *"] },
  "observability": { "enabled": true }
  // Secret (not in this file): ADMIN_INITIAL_PASSWORD — Cloudflare → Workers → ibma → Settings → Variables and Secrets.
}
